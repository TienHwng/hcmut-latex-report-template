% =============================================================================
%  config/report.sty -- layout, packages and macros of the report template
% -----------------------------------------------------------------------------
%  This file contains NO report text. Everything printed on the page comes
%  from config/metadata.tex (title, course, members, ...) or from the files in
%  frontmatter/, chapters/ and appendices/.
%
%  Options:  \usepackage[<language>,<mode>]{config/report}
%    english     (default) English headings, captions and labels
%    vietnamese  Vietnamese headings, captions, labels and \cref names
%    final       (default) print version
%    draft       show \todo / \note margin notes and a DRAFT watermark
%
%  Sections:
%    0. Options                   6. Code listings, boxes & text macros
%    1. Fonts & language          7. Hyperlinks & cross-references
%    2. Page layout               8. Metadata interface (\course, \addmember...)
%    3. Graphics & colours        9. Header & footer
%    4. Floats, captions, tables 10. Cover page & member tables
%    5. Lists & numbering
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/report}[2026/11/03 HCMUT report template]

% -----------------------------------------------------------------------------
%  0. Options
% -----------------------------------------------------------------------------
\newif\ifrpt@vietnamese
\newif\ifrpt@draft
\DeclareOption{english}{\rpt@vietnamesefalse}
\DeclareOption{vietnamese}{\rpt@vietnamesetrue}
\DeclareOption{final}{\rpt@draftfalse}
\DeclareOption{draft}{\rpt@drafttrue}
\DeclareOption*{\PackageWarning{config/report}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

% -----------------------------------------------------------------------------
%  1. Fonts & language  (engine: pdfLaTeX)
% -----------------------------------------------------------------------------
\RequirePackage[utf8]{inputenc}            % babel-vietnamese checks for it
\RequirePackage[T5]{fontenc}               % Vietnamese glyphs (ă, ơ, ư, đ, ...)
\RequirePackage{lmodern}
% Both languages are loaded; the LAST one is the main language.
\ifrpt@vietnamese
  \RequirePackage[english,vietnamese]{babel}
  % babel's Vietnamese name for the bibliography is just "Tài liệu".
  \addto\captionsvietnamese{\renewcommand{\refname}{Tài liệu tham khảo}}
\else
  \RequirePackage[vietnamese,english]{babel}
\fi
% Better justification & spacing. microtype has no protrusion data for the
% T5 typewriter font, so protrusion is limited to the roman/sans families.
\RequirePackage{microtype}
\DeclareMicrotypeSet[protrusion]{rpt@text}{family={rm*,sf*}}
\UseMicrotypeSet[protrusion]{rpt@text}

% -----------------------------------------------------------------------------
%  2. Page layout
% -----------------------------------------------------------------------------
\RequirePackage[
  a4paper,
  left=2.5cm, right=2.5cm,
  top=3.5cm, bottom=2.5cm,                 % distance from paper edge to body
  headheight=28pt,                         % room for the logo in the header
  marginparwidth=2cm, marginparsep=2.5mm,  % width of draft-mode margin notes
  % bindingoffset=1cm,                     % extra inner margin for binding
]{geometry}

% No indentation; paragraphs are separated by vertical space instead.
% Never end a paragraph with \\ -- just leave a blank line.
\RequirePackage{parskip}

% -----------------------------------------------------------------------------
%  3. Graphics & colours
% -----------------------------------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{images/}}                   % \includegraphics{foo} -> images/foo
\RequirePackage[table]{xcolor}             % also loads colortbl (\rowcolor)
\RequirePackage{eso-pic}                   % cover background, draft watermark
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc}

% Theme colours, taken from the HCMUT logo. Change them here to restyle the
% cover, links, highlight boxes and draft notes at once.
\definecolor{primary}{HTML}{032B91}        % dark blue: title, links, boxes
\definecolor{secondary}{HTML}{1488DB}      % light blue: cover rules, notes

% -----------------------------------------------------------------------------
%  4. Floats, captions & tables
% -----------------------------------------------------------------------------
\RequirePackage{float}                     % [H] placement
\RequirePackage[labelfont=bf]{caption}
\RequirePackage{subcaption}                % subfigure / subtable
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{booktabs}                  % \toprule \midrule \bottomrule

% Column types that wrap text without stretching the spaces:
%   L   left-aligned X column     C   centred X column
%   P{w} left-aligned p{w} column
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

% -----------------------------------------------------------------------------
%  5. Lists, math & numbering
% -----------------------------------------------------------------------------
\RequirePackage{enumitem}
\RequirePackage{amsmath}
\RequirePackage{amssymb}

\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}
\numberwithin{equation}{section}
\numberwithin{figure}{section}
\numberwithin{table}{section}

% Appendices: \begin{appendices} ... \end{appendices}
% -> headings "Appendix A ...", also in the table of contents.
\RequirePackage[title,titletoc]{appendix}

% Add "References" to the table of contents (but not the TOC itself).
\RequirePackage[nottoc]{tocbibind}

% -----------------------------------------------------------------------------
%  6. Code listings, highlight boxes & text macros
% -----------------------------------------------------------------------------
\RequirePackage{listings}
\definecolor{codebg}{RGB}{255,255,242}
\definecolor{codekw}{RGB}{38,92,190}
\definecolor{codestring}{RGB}{196,74,116}
\definecolor{codecomment}{RGB}{106,153,85}
\definecolor{codenumber}{RGB}{150,150,150}

\lstdefinestyle{code}{
  basicstyle=\ttfamily\small,
  numbers=left,
  numberstyle=\tiny\color{codenumber},
  numbersep=8pt,
  keywordstyle=\color{codekw}\bfseries,
  stringstyle=\color{codestring},
  commentstyle=\color{codecomment}\itshape,
  backgroundcolor=\color{codebg},
  frame=single,
  breaklines=true,
  tabsize=4,
  captionpos=b,
  keepspaces=true,
  showstringspaces=false,
}
\lstset{style=code}
% Usage: \begin{lstlisting}[language=C, caption={...}, label={lst:foo}]

\RequirePackage[many]{tcolorbox}
% Highlighted box with a title tab.
% Usage: \begin{keybox}{Core problem} ... \end{keybox}
\newtcolorbox{keybox}[1]{
  enhanced,
  colback=primary!5!white,
  colframe=primary,
  colbacktitle=primary,
  coltitle=white,
  boxrule=1.5pt,
  attach boxed title to top left={yshift=-2mm, xshift=5mm},
  title={\large\bfseries #1},
}

% \term{...}: a key concept introduced in the text (bold italic).
\newcommand{\term}[1]{\textbf{\textit{#1}}}

% Draft notes. They are only printed with the [draft] option; in the final
% version they disappear without having to delete them.
%   \todo{Add a source}            orange note in the margin
%   \todo[inline]{Rewrite this}    note across the text width
%   \note[Hưng]{Check this claim}  blue note, optionally signed by a member
%   \listoftodos                   list of all notes (see main.tex)
\ifrpt@draft
  \RequirePackage[colorinlistoftodos, textsize=scriptsize]{todonotes}
  \ifrpt@vietnamese
    \renewcommand{\@todonotes@todolistname}{Danh sách ghi chú}
  \fi
  \AddToShipoutPictureBG{\AtPageCenter{%
    \rotatebox{45}{\makebox[0pt]{%
      \fontsize{110}{110}\selectfont\bfseries\color{gray!12}DRAFT}}}}
\else
  \RequirePackage[disable]{todonotes}
\fi
\newcommand{\note}[2][]{%
  \ifx\relax#1\relax
    \todo[color=secondary!25, bordercolor=secondary]{#2}%
  \else
    \todo[color=secondary!25, bordercolor=secondary, author={#1}]{#2}%
  \fi}

% -----------------------------------------------------------------------------
%  7. Hyperlinks & cross-references  (keep these last)
% -----------------------------------------------------------------------------
\RequirePackage{lastpage}
\RequirePackage[vietnamese]{hyperref}      % Vietnamese glyphs in PDF bookmarks
\hypersetup{
  colorlinks=true,
  linkcolor=primary,
  citecolor=primary,
  urlcolor=primary,
  % hidelinks,                             % uncomment for a print version
}
\ifrpt@vietnamese\hypersetup{pdflang=vi}\else\hypersetup{pdflang=en}\fi
% PDF viewer sidebar: numbered bookmarks, top level expanded.
\RequirePackage[numbered, open, openlevel=1]{bookmark}

% \cref{tab:foo} -> "Table 3.1" (adds the name automatically)
\RequirePackage[capitalise,nameinlink]{cleveref}
\ifrpt@vietnamese
  % cleveref has no Vietnamese names. Names are capitalised because
  % \cref and \Cref print the same text with the [capitalise] option.
  \newcommand*{\rpt@crefname}[2]{\crefname{#1}{#2}{#2}\Crefname{#1}{#2}{#2}}
  \rpt@crefname{section}{Mục}
  \rpt@crefname{subsection}{Mục}
  \rpt@crefname{subsubsection}{Mục}
  \rpt@crefname{paragraph}{Mục}
  \rpt@crefname{appendix}{Phụ lục}
  \rpt@crefname{subappendix}{Phụ lục}
  \rpt@crefname{subsubappendix}{Phụ lục}
  \rpt@crefname{figure}{Hình}
  \rpt@crefname{table}{Bảng}
  \rpt@crefname{equation}{Công thức}
  \rpt@crefname{lstlisting}{Đoạn mã}
  \rpt@crefname{listing}{Đoạn mã}
  \rpt@crefname{item}{Mục}
  \rpt@crefname{footnote}{Chú thích}
  \rpt@crefname{page}{Trang}
\fi

% -----------------------------------------------------------------------------
%  8. Metadata interface -- values are set in config/metadata.tex
%     (\title and \date are the standard LaTeX commands)
% -----------------------------------------------------------------------------
\newcommand*{\university}[1]{\def\rpt@university{#1}}
\newcommand*{\school}[1]{\def\rpt@school{#1}}
\newcommand*{\headertext}[1]{\def\rpt@headertext{#1}}
\newcommand*{\course}[1]{\def\rpt@course{#1}}
\newcommand*{\semester}[1]{\def\rpt@semester{#1}}
\newcommand*{\instructor}[1]{\def\rpt@instructor{#1}}
\newcommand*{\city}[1]{\def\rpt@city{#1}}
\newcommand*{\logo}[1]{\def\rpt@logo{#1}}
\newcommand*{\coverbackground}[1]{\def\rpt@coverbackground{#1}}

\university{}\school{}\headertext{}\course{}\semester{}
\instructor{}\city{}\logo{}\coverbackground{}

% \addmember{Full name}{Student ID}{Contribution}{Workload}
% Members are stored once and printed by the cover and member tables;
% their names also fill the "Author" field of the PDF.
\newcommand*{\rpt@members}{}
\newcommand*{\rpt@authors}{}
\newcommand{\addmember}[4]{%
  \g@addto@macro\rpt@members{\rpt@member{#1}{#2}{#3}{#4}}%
  \ifx\rpt@authors\@empty
    \gdef\rpt@authors{#1}%
  \else
    \g@addto@macro\rpt@authors{, #1}%
  \fi}
\newcounter{rpt@member}

\AtBeginDocument{%
  \hypersetup{
    pdftitle={\@title},
    pdfauthor={\rpt@authors},
    pdfsubject={\rpt@course},
  }}

% Fixed words printed by the template, in the language chosen above.
% \memberlistname and \assessmentname are used in frontmatter/members.tex.
\ifrpt@vietnamese
  \newcommand*{\rpt@txt@instructor}{Giảng viên hướng dẫn}
  \newcommand*{\rpt@txt@studentname}{Họ và tên}
  \newcommand*{\rpt@txt@studentid}{MSSV}
  \newcommand*{\rpt@txt@no}{STT}
  \newcommand*{\rpt@txt@fullname}{Họ và tên}
  \newcommand*{\rpt@txt@contribution}{Nhiệm vụ}
  \newcommand*{\rpt@txt@percentage}{Mức độ}
  \newcommand*{\rpt@txt@evaluation}{Đánh giá}
  \newcommand*{\rpt@txt@semester}{Học kỳ}
  \newcommand*{\rpt@txt@page}{Trang}
  \newcommand*{\memberlistname}{Danh sách thành viên \& phân công}
  \newcommand*{\assessmentname}{Đánh giá của giảng viên}
\else
  \newcommand*{\rpt@txt@instructor}{Instructor}
  \newcommand*{\rpt@txt@studentname}{Student's Name}
  \newcommand*{\rpt@txt@studentid}{Student ID}
  \newcommand*{\rpt@txt@no}{No.}
  \newcommand*{\rpt@txt@fullname}{Full name}
  \newcommand*{\rpt@txt@contribution}{Contribution}
  \newcommand*{\rpt@txt@percentage}{Percentage}
  \newcommand*{\rpt@txt@evaluation}{Evaluation}
  \newcommand*{\rpt@txt@semester}{Semester}
  \newcommand*{\rpt@txt@page}{Page}
  \newcommand*{\memberlistname}{Member List \& Workload}
  \newcommand*{\assessmentname}{Lecturer's Assessment}
\fi

% -----------------------------------------------------------------------------
%  9. Header & footer
% -----------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{%
  \ifx\rpt@logo\@empty\else
    \raisebox{\dimexpr-0.5\height+0.5ex\relax}{%
      \includegraphics[height=8mm]{\rpt@logo}}%
    \hspace{0.5em}%
  \fi
  \textbf{\ttfamily\rpt@headertext}}
% Right header: number and title of the current section.
\fancyhead[R]{\footnotesize\ttfamily\nouppercase{\leftmark}}
\renewcommand{\sectionmark}[1]{%
  \markboth{\ifnum\c@secnumdepth>\z@\thesection\quad\fi#1}{}}
\fancyfoot[L]{\scriptsize\ttfamily
  \rpt@course, \rpt@txt@semester\ \rpt@semester}
\fancyfoot[R]{\scriptsize\ttfamily
  \rpt@txt@page\ \thepage/\pageref*{LastPage}}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\footrulewidth}{0.3pt}

% -----------------------------------------------------------------------------
%  10. Cover page & member tables
% -----------------------------------------------------------------------------
% Students on the cover: name | ID
\newcommand{\printstudenttable}{%
  \begingroup
  \def\rpt@member##1##2##3##4{##1 & ##2 \\}%
  \begin{tabular}{|l|c|}
    \hline
    \multicolumn{1}{|c|}{\textbf{\rpt@txt@studentname}}
      & \textbf{\rpt@txt@studentid} \\
    \hline\hline
    \rpt@members
    \hline
  \end{tabular}%
  \endgroup}

% No. | name | contribution | workload
\newcommand{\printcontributiontable}{%
  \begingroup
  \renewcommand{\arraystretch}{1.5}%
  \def\rpt@member##1##2##3##4{%
    \stepcounter{rpt@member}\arabic{rpt@member}. & ##1 & ##3 & ##4 \\ \hline}%
  \begin{center}
    \begin{tabularx}{\textwidth}{|r|l|L|c|}
      \hline
      \setcounter{rpt@member}{0}%
      \textbf{\rpt@txt@no} & \textbf{\rpt@txt@fullname}
        & \textbf{\rpt@txt@contribution} & \textbf{\rpt@txt@percentage} \\
      \hline\hline
      \rpt@members
    \end{tabularx}
  \end{center}
  \endgroup}

% No. | name | (empty cell for the lecturer)
\newcommand{\printassessmenttable}{%
  \begingroup
  \renewcommand{\arraystretch}{1.5}%
  \def\rpt@member##1##2##3##4{%
    \stepcounter{rpt@member}\arabic{rpt@member}. & ##1 & \\ \hline}%
  \begin{center}
    \begin{tabularx}{\textwidth}{|r|l|C|}
      \hline
      \setcounter{rpt@member}{0}%
      \textbf{\rpt@txt@no} & \textbf{\rpt@txt@fullname}
        & \textbf{\rpt@txt@evaluation} \\
      \hline\hline
      \rpt@members
    \end{tabularx}
  \end{center}
  \endgroup}

\newcommand{\rpt@coverrule}{%
  {\color{secondary}\rule{0.9\linewidth}{0.2mm}}\par}

% Full-page background image, centred, aspect ratio kept.
\newcommand{\rpt@coverbgpicture}{%
  \AtPageLowerLeft{%
    \parbox[b][\paperheight]{\paperwidth}{%
      \vfill\centering
      \includegraphics[width=\paperwidth, height=\paperheight,
                       keepaspectratio]{\rpt@coverbackground}%
      \vfill}}}

\newcommand{\makecover}{%
  \begingroup
  % The cover and the next page are both "page 1"; skipping the cover's
  % PDF anchor avoids hyperref's duplicate "page.1" destination warning.
  \hypersetup{pageanchor=false}%
  \ifx\rpt@coverbackground\@empty\else
    \AddToShipoutPictureBG*{\rpt@coverbgpicture}%
  \fi
  \begin{titlepage}
    \centering
    {\large\bfseries \rpt@university\par \rpt@school\par}
    \vspace{1.5\baselineskip}
    \ifx\rpt@logo\@empty\else
      \includegraphics[width=6cm]{\rpt@logo}\par
      \vspace{1.5\baselineskip}
    \fi
    {\huge\bfseries \rpt@course\par}
    \vspace{\baselineskip}
    \rpt@coverrule
    \vspace{0.5\baselineskip}
    {\Huge\bfseries\itshape\color{primary} \@title\par}
    \vspace{0.75\baselineskip}
    \rpt@coverrule
    \vspace{\baselineskip}
    \textbf{\rpt@txt@instructor:} \rpt@instructor\par
    \vspace{0.5cm}
    \printstudenttable\par
    \vspace{1.25cm}
    \rpt@city, \@date.\par
  \end{titlepage}
  \endgroup}

\endinput
